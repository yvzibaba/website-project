# CI Guard —— 密钥扫描 + TLS 断言 + 基础质量门（待人工审核启用）
# 这是 .example，故意不放在 .github/workflows/ 以免自动运行。
# 审核无误后：cp docs/ci-guard.yml.example .github/workflows/ci-guard.yml 即激活。
# 背景与依据见 docs/DEPLOY_SECURITY_RUNBOOK.md §3、§5。
name: CI Guard
on:
  push:
    branches: [main]
  pull_request:

jobs:
  secret-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      - name: Fail on plaintext secrets
        run: |
          if git grep -nE 'sk-[a-z0-9]{20,}|postgresql://[^:]+:[^@]{6,}@' -- ':!*.example' ':!docs'; then
            echo "Found possible plaintext secret in tracked files"; exit 1
          fi
          echo "No plaintext secrets detected."

  tls-guard:
    runs-on: ubuntu-latest
    steps:
      - name: Assert TLS verification is ON
        run: |
          if [ "${NODE_TLS_REJECT_UNAUTHORIZED:-1}" = "0" ]; then
            echo "NODE_TLS_REJECT_UNAUTHORIZED=0 must NEVER be set in CI/prod"; exit 1
          fi
          echo "TLS verification OK."

  # 内核边界守卫（R9.1）。为什么必须在 CI 里跑、而不是靠人记得：
  # 内核越界的失效是**静默的** —— 往内核写一行 `import ... from "@/auth"`，typecheck 通过、
  # 1167 个测试全绿、构建成功，只有换底座那天才炸。测试测的是「算得对不对」，
  # 测不了「边界有没有被越」。所以必须有一条独立于测试的门。
  # 依据：docs/ai-rules/03-KERNEL.md §3。
  kernel-guard:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Kernel boundary guard (framework-free / no host back-reference)
        run: node .kernel-tools/verify_kernel.mjs .
      - name: No dangling imports after refactors
        run: node .kernel-tools/survey_dangling_refs.mjs .

  quality:
    runs-on: ubuntu-latest
    needs: [secret-scan, tls-guard, kernel-guard]
    env:
      DATABASE_URL: ""
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      # 新克隆必须先生成 Next 的路由类型（LayoutProps 等），否则 tsc 会报
      # "Cannot find name 'LayoutProps'"。这一坑已实测踩中，见 docs/ai-rules/05-TESTING.md。
      - run: npm ci
      - run: npx next typegen
      - run: npx tsc --noEmit
      - run: npm run lint
      - run: npm run test
