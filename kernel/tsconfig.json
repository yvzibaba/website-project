{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/kernel": ["./src/index.ts"],
      "@app/kernel/*": ["./src/*"]
    },
    "lib": ["ES2022"],
    "types": ["node"],
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
