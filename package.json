{
  "name": "website-project",
  "version": "0.80.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "kernel:verify": "node .kernel-tools/verify_kernel.mjs .",
    "kernel:dangling": "node .kernel-tools/survey_dangling_refs.mjs .",
    "kernel:typecheck": "tsc --noEmit -p kernel/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration --no-file-parallelism",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:seed:benchmark": "node --env-file=.env --import tsx scripts/seed-benchmark.ts",
    "db:recompute-scores": "node --env-file=.env --import tsx scripts/recompute-scores.ts",
    "user:promote": "node --env-file=.env --import tsx scripts/promote-user.ts",
    "db:studio": "prisma studio",
    "regen:sml": "node scripts/sml-regen.mjs",
    "params:export": "node --import tsx scripts/export-region-params.ts",
    "ops:metrics": "node --env-file=.env scripts/ops-metrics.mjs",
    "test:tally": "node scripts/tally-real-user-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
