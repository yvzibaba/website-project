# .env.example — 环境变量模板（占位，绝不含真实值）
# 用法：cp .env.example .env.local 后填入真实值。.env* 已被 .gitignore 忽略，切勿提交真实密钥。
# 规则：所有密钥只走环境变量；禁止进前端、禁止进 Git（SECURITY.md / 总控第13节）。

# ---- 数据库 (PostgreSQL + Prisma) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/industry_db?schema=public"

# ---- 认证 (已定：Auth.js v5 / next-auth@beta，Credentials 邮箱+密码 + JWT 会话) ----
# AUTH_SECRET 用于签发/校验 JWT，生产环境必填，缺失 Auth.js 直接报错。
# 生成：openssl rand -base64 32   （或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"）
AUTH_SECRET=""                  # 32 字节随机串的 base64
# 部署在反向代理后若出现回调 URL 不对，可显式指定站点 URL（本机开发/next start 可不填，走 trustHost）
# AUTH_URL="http://localhost:3000"
# 第三方 OAuth（V1-A 未启用；将来如加 GitHub/Google 登录再填）
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ---- Model Router (核心模型 Qwen3.8-Max；禁止在业务代码硬编码模型名) ----
# 各供应商 Key（按需启用，仅服务端读取）
# DASHSCOPE_API_KEY=""          # Qwen
# DEEPSEEK_API_KEY=""
# GLM_API_KEY=""
# KIMI_API_KEY=""
# OPENAI_API_KEY=""             # 兼容层（如用）
# 默认能力等级 -> 供应商/模型 的映射放在配置层，不在此硬编码业务逻辑

# ---- 对象存储 (企业文件 / PDF 导出，兼容 S3) ----
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ---- 支付 (V1 可先"支付说明 + 后台确认"；预留多渠道) ----
# STRIPE_SECRET_KEY=""
# ALIPAY_APP_ID=""
# WECHATPAY_MCHID=""

# ---- 应用 ----
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NODE_ENV="development"
# LOG_LEVEL="info"
