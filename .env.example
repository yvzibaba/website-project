# .env.example — 环境变量模板（占位，绝不含真实值）
# 用法：cp .env.example .env.local 后填入真实值。.env* 已被 .gitignore 忽略，切勿提交真实密钥。
# 规则：所有密钥只走环境变量；禁止进前端、禁止进 Git（SECURITY.md / 总控第13节）。

# ---- 数据库 (PostgreSQL + Prisma) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/industry_db?schema=public"

# ---- 认证 (已定：Auth.js v5 / next-auth@beta，Credentials 邮箱+密码 + JWT 会话) ----
# AUTH_SECRET 用于签发/校验 JWT，生产环境必填，缺失 Auth.js 直接报错。
# 生成：openssl rand -base64 32   （或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"）
AUTH_SECRET=""                  # 32 字节随机串的 base64
# 部署在反向代理后若出现回调 URL 不对，可显式指定站点 URL（本机开发/next start 可不填，走 trustHost）
# AUTH_URL="http://localhost:3000"
# 第三方 OAuth（V1-A 未启用；将来如加 GitHub/Google 登录再填）
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ---- Model Router (§16 统一接口；禁止在业务代码硬编码模型名) ----
# 各供应商 Key（按需启用，仅服务端读取）
# DASHSCOPE_API_KEY=""          # Qwen
# GLM_API_KEY=""
# KIMI_API_KEY=""
# OPENAI_API_KEY=""             # 兼容层（如用）

# DeepSeek（OpenAI 兼容，Phase 9 M3 首个真实 provider）。有 key 时 createChatProvider() 返回真实
#   DeepSeekProvider，无 key 自动回落确定性 StubProvider（离线/CI 无需 key）。
# DEEPSEEK_API_KEY=""                              # ⚠️ 真实密钥只进本地 .env / 部署 secret，绝不提交
# DEEPSEEK_BASE_URL="https://api.deepseek.com"     # 可省，默认即此
#
# 层级 → 真实模型 映射（覆写 MODEL_CATALOG 默认 stub-*；调用即以此 id 发往供应商）：
# MODEL_ID_LOW="deepseek-chat"
# MODEL_ID_MEDIUM="deepseek-chat"
# MODEL_ID_HIGH="deepseek-reasoner"                # 复杂研究/裁判走推理模型
#
# 层级 → 每 1K token 单价（USD），供 estimateCost 程序计算成本（§31）。
#   ⚠️ 下列数字仅为示例占位，务必以 DeepSeek 官方定价页（含峰谷价）为准核对后填入；填错只影响
#   成本估算、不影响调用本身。换算：官方「每 1M token 元」需先折算成「每 1K token USD」。
# MODEL_PRICE_IN_LOW="0.00027"   # 示例：≈$0.27/1M 输入（请以官网为准）
# MODEL_PRICE_OUT_LOW="0.0011"   # 示例：≈$1.10/1M 输出
# MODEL_PRICE_IN_MEDIUM="0.00027"
# MODEL_PRICE_OUT_MEDIUM="0.0011"
# MODEL_PRICE_IN_HIGH="0.00055"  # 示例：≈$0.55/1M（deepseek-reasoner，请以官网为准）
# MODEL_PRICE_OUT_HIGH="0.00219" # 示例：≈$2.19/1M
# 默认能力等级 -> 供应商/模型 的映射放在配置层（上面的 MODEL_ID_*/MODEL_PRICE_*），不硬编码进业务逻辑

# ---- 对象存储 (企业文件 / PDF 导出，兼容 S3) ----
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ---- 支付 (V1 可先"支付说明 + 后台确认"；预留多渠道) ----
# STRIPE_SECRET_KEY=""
# ALIPAY_APP_ID=""
# WECHATPAY_MCHID=""

# ---- 过渡版人工收款说明（决策1·无支付网关/无自动回调·仅服务端读取，故不带 NEXT_PUBLIC 前缀）----
#   这 4 项由 src/lib/payment-info.ts 读取，渲染在订单详情页「如何付款」卡片的可配置收款说明。
#   ★§20 诚实硬约束：以下均为占位、绝不含真实账户。任一项留空/纯空白即视为未配置；
#     PAYEE_NAME / PAYMENT_ACCOUNT / PAYMENT_INSTRUCTION 三者全缺 → 页面统一显示"人工付款信息待配置"，
#     系统绝不虚构收款人/账号/二维码/价格。公开收款前须由创始人填入真实账户并经法务终稿（Runbook §6）。
#   PAYMENT_NOTE 为可选补充说明（如"付款后备注订单号"），单独存在不算已配置。
# PAYEE_NAME=""          # 收款方名称（须为真实、可核验的收款主体）
# PAYMENT_ACCOUNT=""     # 收款账号 / 收款渠道标识（须真实，勿虚构）
# PAYMENT_INSTRUCTION="" # 人工付款步骤说明（如银行转账指引）
# PAYMENT_NOTE=""        # 可选补充提示（如备注订单号、防诈提醒）

# ---- 过渡版客服联系入口（决策1.5·修付款页「请联系客服」死胡同·仅服务端读取）----
#   由 src/lib/payment-info.ts::getSupportContact() 读取，渲染在订单详情页「客服入口」卡片。
#   ★§20 诚实硬约束：以下均为占位、绝不含真实邮箱/微信号/链接。任一项留空/纯空白即视为未配置；
#     SUPPORT_EMAIL / SUPPORT_WECHAT / SUPPORT_URL 三者全缺 → 页面统一显示"客服联系信息待配置"，
#     系统绝不虚构联系方式。公开收款前须由创始人填入真实客服渠道并经法务过审（Runbook §6）。
#   SUPPORT_URL 前端渲染时会再校一次 `https:` 协议，非 https 只显示为纯文本，避免 javascript:/data: 混入。
# SUPPORT_EMAIL=""       # 客服邮箱（渲染为 mailto: 链接，如 support@your-company.example）
# SUPPORT_WECHAT=""      # 客服微信号 / 企业微信名片（纯文本展示）
# SUPPORT_URL=""         # 客服表单页 / 帮助中心（须 https）

# ---- 应用 ----
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NODE_ENV="development"
# LOG_LEVEL="info"
